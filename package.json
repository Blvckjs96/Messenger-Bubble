{
  "name": "messenger-bubble",
  "productName": "Messenger-Bubble",
  "version": "1.4.1",
  "description": "Messenger for macOS with an Android-style floating chat bubble. Fork of messenger-mac by Stefan Minch.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build": "electron-builder --mac"
  },
  "author": "Jason (fork maintainer, floating bubble); original app by Stefan Minch",
  "contributors": [
    "Stefan Minch (original messenger-mac)",
    "Jason (floating bubble feature)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Blvckjs96/Messenger-Bubble#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blvckjs96/Messenger-Bubble.git"
  },
  "bugs": {
    "url": "https://github.com/Blvckjs96/Messenger-Bubble/issues"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@44.10.1": true
  },
  "build": {
    "appId": "com.jason.messenger-bubble",
    "afterPack": "scripts/adhoc-sign.js",
    "afterAllArtifactBuild": "scripts/clean-unpacked.js",
    "productName": "Messenger-Bubble",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "bubble/**",
      "ui/**",
      "package.json",
      "LICENSE",
      "!**/.impeccable/**"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
